# ============================================================
# ShramAI Environment Configuration
# ============================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="ShramAI — Labour Compliance & Inspection Intelligence"
API_V1_PREFIX=/api/v1

# Security & Authentication (JWT)
SECRET_KEY=generate_a_random_32_character_secret_here
JWT_SECRET=generate_a_random_32_character_secret_here

# Database Configuration (PostgreSQL on Render or local SQLite fallback)
# Render provides DATABASE_URL automatically if using Render PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/database_name

# Frontend / CORS Configuration
# Set FRONTEND_URL to your Vercel deployment domain
FRONTEND_URL=https://your-shramai-app.vercel.app
CORS_ORIGINS=http://localhost:5173,https://your-shramai-app.vercel.app

# Optional External AI / OCR / Embedding APIs (Server-Side Only)
LLM_API_KEY=
OCR_API_KEY=
EMBEDDING_API_KEY=

# Document Storage (Ephemeral on free tier; abstracted for S3/Blob storage)
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed

# ============================================================
# Frontend Environment Variables (Set in Vercel Settings)
# ============================================================
# VITE_API_BASE_URL=https://your-shram-backend.onrender.com

