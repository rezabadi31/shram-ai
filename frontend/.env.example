# ============================================================
# ShramAI Frontend Environment Configuration (Vercel)
# ============================================================

# Backend API Base URL
# In production on Vercel: Set this to your deployed Render backend service URL.
# Example: VITE_API_BASE_URL=https://shram-backend.onrender.com
# In local development: Leave empty to use local Vite reverse proxy (/api/v1) or set to http://localhost:8000
VITE_API_BASE_URL=
